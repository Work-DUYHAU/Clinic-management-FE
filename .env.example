# ============================================================
# CẤU HÌNH KẾT NỐI VNPT SMARTCA (CHỮ KÝ SỐ TỪ XA)
# ============================================================
# Môi trường kết nối: demo | production
VITE_SMARTCA_ENV=production

# Mã định danh ứng dụng do VNPT cấp cho Phòng khám (nhập mã do VNPT cấp)
VITE_SMARTCA_CLIENT_ID=492b-638935469277205316.apps.smartcaapi.com
VITE_SMARTCA_SP_ID=492b-638935469277205316.apps.smartcaapi.com

# Khóa bí mật do VNPT cấp (nhập khóa bí mật do VNPT cấp)
VITE_SMARTCA_CLIENT_SECRET=MjAxYWEwOTk-Y2UzMi00OTJi
VITE_SMARTCA_SP_PASSWORD=MjAxYWEwOTk-Y2UzMi00OTJi

# Mã số thuế đơn vị (MST - 10 số): Dùng ký số theo đơn vị/cơ sở KCB
VITE_SMARTCA_DEFAULT_MST=4001266514
VITE_SMARTCA_USER_ID=4001266514

# Số CCCD bác sĩ (12 số): Dùng ký số cá nhân (để trống nếu chỉ ký đơn vị)
VITE_SMARTCA_DEFAULT_CCCD=

# Mật khẩu tài khoản ký số VNPT SmartCA (nhập pass để hệ thống tự điền sẵn)
VITE_SMARTCA_PASSWORD=Fqvn@8192

# Khóa bí mật Smart OTP (TOTP Secret Key Base32) để tự động sinh mã OTP ký 1-click
VITE_SMARTCA_TOTP_SECRET=RDIzMTk1RTM2NUU5MzkxODY3QjJBNDNDOTdBMkM4RUQ=

# ============================================================
# CẤU HÌNH LIÊN THÔNG CỔNG BẢO HIỂM XÃ HỘI (BHXH GATEWAY)
# ============================================================
# Môi trường chạy: 'sandbox' (Thử nghiệm / Test) | 'production' (Cổng chính thức BHXH)
# - Khi để 'sandbox': Tự động kết nối Cổng Test BHXH: https://gdbhyt.baohiemxahoi.gov.vn
# - Khi để 'production': Tự động kết nối Cổng Thật BHXH: https://egw.baohiemxahoi.gov.vn
VITE_BHXH_ENV=production

# URL Cổng BHXH (khi chạy web dev qua Vite Proxy dùng /api-bhxh để tránh lỗi CORS)
VITE_BHXH_BASE_URL=/api-bhxh

# Tài khoản & Mật khẩu kết nối Cổng Giao dịch điện tử BHXH (do BHXH cấp)
VITE_BHXH_USERNAME=49939_BV
VITE_BHXH_PASSWORD=Toc1908@81

# Mã Cơ sở Khám chữa bệnh BHYT mặc định
